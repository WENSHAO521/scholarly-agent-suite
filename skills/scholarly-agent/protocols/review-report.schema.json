{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scholarly-agent-suite/protocols/review-report.schema.json",
  "title": "REVIEW_REPORT_V1",
  "description": "One simulated reviewer's report on a manuscript, produced by a peer-review-engine reviewer role (often an isolated subagent) and consumed by the editor role. See modules/peer-review-engine/references/review-report.md.",
  "type": "object",
  "required": ["protocol", "reviewer_id", "lens", "summary", "strengths", "concerns", "recommendation", "confidence", "independence"],
  "properties": {
    "protocol": { "const": "REVIEW_REPORT_V1" },
    "reviewer_id": { "type": "string", "pattern": "^R[0-9]+$" },
    "lens": {
      "type": "string",
      "enum": ["methods", "statistics", "theory", "literature", "field", "ethics-integrity", "devils-advocate", "generalist"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "location", "issue", "evidence", "request", "fixable"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+-C[0-9]+$" },
          "severity": { "type": "string", "enum": ["fatal", "major", "minor"] },
          "category": {
            "type": "string",
            "enum": ["validity", "methods", "theory", "contribution", "literature", "presentation", "ethics", "reproducibility", "scope"]
          },
          "location": { "type": "string" },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "request": { "type": "string" },
          "fixable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "questions_for_authors": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": "string", "enum": ["accept", "minor-revision", "major-revision", "reject-resubmit", "reject"] },
    "confidence": { "type": "string", "enum": ["low", "moderate", "high"] },
    "confidential_to_editor": { "type": "string" },
    "independence": {
      "type": "object",
      "required": ["mode", "saw_other_reports"],
      "properties": {
        "mode": { "type": "string", "enum": ["isolated-subagent", "sequential-single-model"] },
        "saw_other_reports": { "const": false }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
