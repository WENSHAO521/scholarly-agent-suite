{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scholarly-agent-suite/protocols/polish-report.schema.json",
  "title": "POLISH_REPORT_V1",
  "description": "What a prose-polish-engine pass changed and what it kept: templated-phrasing counts before and after, the change log, findings left in place, and the check that citations, numbers, quotations, and formulas survived unchanged. Produced by prose-polish-engine (ppe.report.build_polish_report) and consumed by the dispatcher's final quality gate. See modules/prose-polish-engine/references/polish-report.md.",
  "type": "object",
  "required": [
    "protocol",
    "language",
    "catalog",
    "level",
    "before",
    "after",
    "changes",
    "remaining",
    "invariants",
    "status",
    "notice"
  ],
  "properties": {
    "protocol": {
      "const": "POLISH_REPORT_V1"
    },
    "language": {
      "type": "string",
      "description": "ISO 639 code of the text's language (any language; see ppe.languages)."
    },
    "catalog": {
      "type": "boolean",
      "description": "true when ppe.patterns has a phrase catalog for this language"
    },
    "level": {
      "type": "string",
      "enum": [
        "light",
        "standard",
        "deep"
      ]
    },
    "before": {
      "type": "object",
      "required": [
        "pattern_load",
        "density",
        "by_category",
        "must_remove",
        "units"
      ],
      "properties": {
        "pattern_load": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "density": {
          "type": "number"
        },
        "by_category": {
          "type": "object"
        },
        "must_remove": {
          "type": "integer"
        },
        "units": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "required": [
        "pattern_load",
        "density",
        "by_category",
        "must_remove",
        "units"
      ],
      "properties": {
        "pattern_load": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "density": {
          "type": "number"
        },
        "by_category": {
          "type": "object"
        },
        "must_remove": {
          "type": "integer"
        },
        "units": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "before",
          "after"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "chat-residue",
              "stock-connective",
              "empty-emphasis",
              "inflated-vocabulary",
              "formulaic-frame",
              "stock-summary",
              "hedge-stack",
              "contrast-template",
              "nominalization",
              "repeated-opener",
              "uniform-rhythm",
              "triplet-habit",
              "dash-habit"
            ]
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "remove",
              "revise",
              "watch"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "kept_because": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "object",
      "required": [
        "status",
        "failures",
        "warnings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "REVIEW",
            "FAIL"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "length_ratio": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REVIEW",
        "FAIL"
      ]
    },
    "notice": {
      "type": "string"
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
