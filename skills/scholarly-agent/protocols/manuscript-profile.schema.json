{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scholarly-agent-suite/protocols/manuscript-profile.schema.json",
  "title": "MANUSCRIPT_PROFILE_V1",
  "description": "A structured profile of one manuscript, produced by scholarly-voice-engine (from an audit/draft) or supplied directly by the user, and consumed primarily by journal-fit-engine.",
  "type": "object",
  "required": ["protocol", "discipline", "article_type"],
  "properties": {
    "protocol": { "const": "MANUSCRIPT_PROFILE_V1" },
    "discipline": { "type": "string" },
    "topic": { "type": "string" },
    "research_question": { "type": "string" },
    "contribution": { "type": "string" },
    "methods": { "type": "string" },
    "data": { "type": "string" },
    "article_type": {
      "type": "string",
      "enum": ["empirical", "theory", "review", "commentary", "case-study", "book-chapter", "other"]
    },
    "audience": { "type": "string" },
    "geography": { "type": "string" },
    "constraints": {
      "type": "object",
      "description": "Hard/soft constraints relevant to venue fit (word limit, language, citation style, deadline).",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
