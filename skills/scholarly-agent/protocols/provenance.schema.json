{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scholarly-agent-suite/protocols/provenance.schema.json",
  "title": "PROVENANCE_RECORD_V1",
  "description": "Shared provenance record embedded in other protocols (profiles, journal contexts, continuity state). See shared/provenance-policy.md for the rules this record must satisfy.",
  "type": "object",
  "required": ["protocol", "sources", "retrieval_date", "verification_status"],
  "properties": {
    "protocol": { "const": "PROVENANCE_RECORD_V1" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "access_status"],
        "properties": {
          "identity": { "type": "string", "description": "DOI, ISSN, URL, or user-supplied file identifier." },
          "access_status": {
            "type": "string",
            "enum": ["open-access", "metadata-only", "user-supplied", "access-restricted", "unknown"]
          }
        },
        "additionalProperties": true
      }
    },
    "retrieval_date": { "type": "string", "format": "date" },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "unverified", "partially-verified", "conflicting"]
    },
    "conflict_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Populated when two sources disagree on a field; never silently resolved."
    }
  },
  "additionalProperties": false
}
